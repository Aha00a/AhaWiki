# schemaDump.sh 의 폴백이다. 보통은 이 파일을 쓰지 않는다.
#
# 평소 자격증명은 앱이 이미 쓰는 설정 하나에서 온다:
#   ~/.config/ahawiki/application.local.dev.conf  (AHAWIKI_CONF 로 다른 파일 지정 가능)
# 거기 db.default.url · username · password 가 있고 schemaDump.sh 가 직접 읽는다.
#
# 그러니 이 파일을 채워 `.env` 를 만들기 전에 한 번 생각할 것 — 같은 DB 비밀번호를 저장소
# 안에 한 벌 더 두는 일이다. 예전에 그랬고, 2026-09-02 에 이 체크아웃이 통째로 사라졌을 때
# 저장소 밖 설정은 살아남고 그 사본만 없어졌다. 설정이 없는 기계에서만 쓸 것.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
