<!-- https://www.playframework.com/documentation/latest/SettingsLogger -->
<configuration>

  <!--
    One file per instance, rolled daily and capped.

    Until 2026-09-26 this was a plain FileAppender on logs/application.log, and both production
    instances wrote to that one file: nothing ever rolled it, and it reached 491MB of 53 days on a
    disk at 74% (see the wiki page Dev Logs). A RollingFileAppender cannot be shared by two
    processes - both would try to rename the same file at midnight - so the port each instance is
    started with (-Dhttp.port, which the systemd unit passes) goes into the name. Reading both
    timelines at once is `sort -m` of the two files; losing that is the price of a file that is
    rolled at all. Outside production http.port is usually unset and the name falls back to "app".
  -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${application.home:-.}/logs/application-${http.port:-app}.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${application.home:-.}/logs/application-${http.port:-app}.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <charset>UTF-8</charset>
      <pattern>%date [%level] from %logger in %thread - %message%n%xException</pattern>
    </encoder>
  </appender>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <withJansi>true</withJansi>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level %-31logger{31} %message%n%xException{10}</pattern>
    </encoder>
  </appender>

  <appender name="ASYNCFILE" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>1024</queueSize>
    <discardingThreshold>20</discardingThreshold>
    <neverBlock>true</neverBlock>
    <appender-ref ref="FILE" />
  </appender>

  <appender name="ASYNCSTDOUT" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>1024</queueSize>
    <discardingThreshold>20</discardingThreshold>
    <neverBlock>true</neverBlock>
    <appender-ref ref="STDOUT" />
  </appender>

  <logger name="play" level="INFO" />
  <logger name="application" level="DEBUG" />
  <logger name="actors" level="INFO" />
  <logger name="com.aha00a" level="INFO" />
  <logger name="controllers" level="INFO" />
  <logger name="models" level="INFO" />
  <logger name="filters" level="INFO" />
  <logger name="logics" level="INFO" />
  <logger name="services" level="INFO" />

  <!-- https://hibernate.atlassian.net/browse/HV-1323 -->
  <logger name="org.hibernate.validator.messageinterpolation.ParameterMessageInterpolator" level="INFO" />

  <logger name="play.api.db.evolutions" level="DEBUG" />

  <logger name="org.jdbcdslog.ConnectionLogger" level="OFF" />
  <logger name="org.jdbcdslog.StatementLogger"  level="OFF" />
<!--  <logger name="org.jdbcdslog.StatementLogger"  level="INFO" />-->
  <logger name="org.jdbcdslog.ResultSetLogger"  level="OFF" />

  <!-- Off these ones as they are annoying, and anyway we manage configuration ourselves -->
  <logger name="com.avaje.ebean.config.PropertyMapLoader" level="OFF" />
  <logger name="com.avaje.ebeaninternal.server.core.XmlConfigLoader" level="OFF" />
  <logger name="com.avaje.ebeaninternal.server.lib.BackgroundThread" level="OFF" />
  <logger name="com.gargoylesoftware.htmlunit.javascript" level="OFF" />

  <root level="WARN">
    <appender-ref ref="ASYNCFILE" />
    <appender-ref ref="ASYNCSTDOUT" />
  </root>

</configuration>
